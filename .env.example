# Panchayat360 / Poll-Pulse AP — public env template
# Copy to .env.local and fill from Supabase project settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional gate for POST /api/admin/ingest-gps
ADMIN_INGEST_SECRET=

# Telegram ops bot (BotFather) + ops chat/channel id
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# Edge Function secrets (also set via `supabase secrets set`)
FUNCTION_SECRET=
